{
  "database_path": "data/news.db",
  "log_path": "logs/app.log",
  "request_timeout_seconds": 10,
  "request_delay_seconds": 1.0,
  "duplicate_policy": "skip",
  "default_ai_model": "gpt-4o-mini",
  "user_agent": "ai-news-cli/1.0 (+educational CLI project; contact: your-email@example.com)",
  "respect_robots_txt": true,
  "summary_language": "Korean",
  "max_analysis_articles": 50,
  "max_analysis_chars": 20000,
  "max_body_chars_for_ai": 4000,
  "sources": {
    "default_rss": {
      "type": "rss",
      "url": "https://openapi.naver.com/v1/search/news.xml",
      "params": {
        "query": "AI",
        "display": 20,
        "sort": "date"
      },
      "auth_header_env": {
        "X-Naver-Client-Id": "NAVER_CLIENT_ID",
        "X-Naver-Client-Secret": "NAVER_CLIENT_SECRET"
      },
      "category": "AI"
    },
    "naver_it": {
      "type": "rss",
      "url": "https://openapi.naver.com/v1/search/news.xml",
      "params": {
        "query": "반도체",
        "display": 20,
        "sort": "date"
      },
      "auth_header_env": {
        "X-Naver-Client-Id": "NAVER_CLIENT_ID",
        "X-Naver-Client-Secret": "NAVER_CLIENT_SECRET"
      },
      "category": "IT"
    },
    "default_web": {
      "type": "web",
      "list_url": "https://zdnet.co.kr/news/?lstcode=0050",
      "base_url": "https://zdnet.co.kr",
      "article_link_selector": "a[href*=\"/view/?no=\"]",
      "title_selector": "h1",
      "body_selector": ".view_cont p",
      "date_selector": "meta[property=\"article:published_time\"]",
      "category": "IT"
    }
  }
}
